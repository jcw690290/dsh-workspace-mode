{
  "name": "dsh-workspace-mode",
  "version": "0.3.0",
  "description": "Per-workspace default permission preset and mode (agent preset) for DSH: assign a permission preset and/or an agent preset to each workspace directory from Settings, and every new session opened there starts with them.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "test",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "permission",
    "workspace",
    "settings",
    "agent-preset",
    "mode"
  ],
  "scripts": {
    "test": "node test/match.test.mjs && node test/plugin.test.mjs && node test/settings.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
